# Example configuration for /etc/greetd/config.toml
#
# Airlock runs inside a minimal Wayland compositor like Cage or Hyprland.

[terminal]
# The VT on which to run the greeter
vt = 1

[default_session]
# Output is silenced to prevent a tty screen from flashing before the greeter appears
command = "cage -s -- astra-airlock >/dev/null 2>&1"
user = "greeter"
