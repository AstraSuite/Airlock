#!/usr/bin/env sh
# Caelestia Greeter Launcher Script for Greetd / Cage / Compositors

set -e

# Export standard Wayland & Qt environment variables
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"

# Directory containing this launcher (absolute, normalized)
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

# Determine installation or development configuration path
if [ -n "$CAELESTIA_GREETER_DIR" ] && [ -d "$CAELESTIA_GREETER_DIR" ]; then
    CONFIG_PATH="$CAELESTIA_GREETER_DIR"
elif [ -d "/etc/xdg/quickshell/caelestia-greeter" ]; then
    CONFIG_PATH="/etc/xdg/quickshell/caelestia-greeter"
elif [ -d "$SCRIPT_DIR/../etc/xdg/quickshell/caelestia-greeter" ]; then
    CONFIG_PATH="$SCRIPT_DIR/../etc/xdg/quickshell/caelestia-greeter"
elif [ -d "/usr/share/caelestia-greeter" ]; then
    CONFIG_PATH="/usr/share/caelestia-greeter"
elif [ -f "$SCRIPT_DIR/../shell.qml" ]; then
    CONFIG_PATH="$SCRIPT_DIR/.."
else
    echo "caelestia-greeter: could not locate configuration directory (set CAELESTIA_GREETER_DIR)" >&2
    exit 1
fi

exec quickshell -p "$CONFIG_PATH" "$@"
